# HIUHU Platform Environment Configuration

# Database: PostgreSQL (Prisma)
# Example: postgresql://USER:PASSWORD@localhost:5432/hiuhu_db?schema=public
DATABASE_URL="postgresql://hiuhu_user:hiuhu_secret@localhost:5432/hiuhu_db?schema=public"

# Authentication & Session
NEXTAUTH_SECRET="hiuhu_super_secret_session_token_key_minimum_32_characters"
JWT_SECRET="hiuhu_jwt_secret_signing_key_literary_publishing_cms_2026"

# Initial SUPER_ADMIN Identity (Created automatically during seeding)
ADMIN_EMAIL="admin@hiuhu.org"
ADMIN_PASSWORD="AdminPassword2026!"
ADMIN_NAME="HIUHU"

# File Storage Provider ("local" for local disk fallback, "s3" for S3-compatible cloud storage)
STORAGE_PROVIDER="local"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="hiuhu-media"
STORAGE_REGION="us-east-1"

# Email Configuration (SMTP, Resend, or local logger)
EMAIL_PROVIDER="console" # "console", "smtp", or "resend"
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="HIUHU Literary Press <editor@hiuhu.org>"

# Public Website URL & Metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="HIUHU"
NEXT_PUBLIC_SITE_TAGLINE="A Sanctuary for Discerning Voices and Timeless Literature"
